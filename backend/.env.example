# Django Configuration
DEBUG=False
SECRET_KEY=change-me-to-a-secure-random-64-character-key
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app

# Database Configuration (Railway PostgreSQL automatically provides DATABASE_URL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/smarthcm

# CORS Configuration (Set to your Next.js Railway URL or frontend domain)
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.up.railway.app
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.railway.app

# Concurrency & Performance
WEB_CONCURRENCY=3
PORT=8000
