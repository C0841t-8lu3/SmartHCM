# ==============================================================================
# SmartHCM Production Environment Variables Template
# NEVER commit your actual .env file or real secrets to a public repository!
# ==============================================================================

# Django Core Security
DEBUG=False
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-cryptographically-random-64-character-string-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app

# Database Configuration (PostgreSQL URL provided automatically by Railway)
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/smarthcm

# Cross-Origin Resource Sharing (CORS) & CSRF Whitelists
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.up.railway.app
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.railway.app

# Performance & Concurrency
WEB_CONCURRENCY=3
PORT=8000
